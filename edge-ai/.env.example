# SkyWatch Edge-AI — Environment Variables
# Copy this file to .env before running detector.py

# Backend server URL
SERVER_URL=http://localhost:8080

# Path to the drone feed video
# Default path is the backend mission footage location
VIDEO_PATH=../backend/public/mission_footagee.mp4

# Edge-AI API key for backend requests
# Change this value for your local/deployment environment
DRONE_API_KEY=dev-drone-key-change-me
