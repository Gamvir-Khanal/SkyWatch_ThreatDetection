# SkyWatch Backend — Environment Variables
# Copy this file to .env and set your own values.

# Pre-shared key for AES-256-CBC payload encryption and HMAC-SHA256 request signing.
# Must match SKYWATCH_PSK on the backend AND VITE_SKYWATCH_PSK in frontend/.env
# Default (dev only): SkyWatch-Tactical-PSK-v1-CHANGE-IN-PROD
SKYWATCH_PSK=SkyWatch-Tactical-PSK-v1-CHANGE-IN-PROD

# HTTP port for the Express server (default: 5000)
PORT=5000
